{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "web:dev": "npm run dev",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:electron": "vite build && esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/main.js",
    "pack": "npm run build:electron && electron-builder --mac",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "electron:dev": "npm run dev & ts-node electron/main.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.example.torrentdownloader",
    "productName": "TorrentDownloader",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg", "dir"]
    },
    "files": [
      "dist/**/*"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ts-node": "^10.9.2",
    "vite": "^6.2.3",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/webtorrent": "^0.110.1",
    "autoprefixer": "^10.4.21",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
